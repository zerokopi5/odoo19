{
  "name": "odoo19-video",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "postCreateCommand": "npm ci && npx remotion browser ensure && git config core.hooksPath .githooks",
  "postAttachCommand": "echo 'Ready. Start the studio with: npm run dev'",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Remotion Studio",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.eol": "\n",
        "editor.formatOnSave": true
      }
    }
  }
}
